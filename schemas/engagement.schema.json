{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/solution-engineering-engagement-v1.json",
  "title": "Solution Engineering Engagement",
  "type": "object",
  "required": ["engagement_id", "customer", "assumptions", "requirements", "options", "traceability"],
  "properties": {
    "engagement_id": {"type": "string", "minLength": 1},
    "customer": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "category", "priority", "acceptance_test"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "category": {"enum": ["business", "platform", "network", "security", "operations", "commercial"]},
          "priority": {"enum": ["must", "should", "could"]},
          "acceptance_test": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "options": {"type": "array", "minItems": 1},
    "traceability": {"type": "object"}
  }
}
